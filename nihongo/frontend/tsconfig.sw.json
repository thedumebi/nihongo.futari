{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.sw.tsbuildinfo",
    "lib": ["ESNext", "WebWorker"],
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": { "@/*": ["./src/*"] },
    "types": ["vite/client"],
    "noEmit": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/sw.ts"]
}
