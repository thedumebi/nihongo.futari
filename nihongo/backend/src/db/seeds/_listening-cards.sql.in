-- Listening and dictation cards for every word whose audio really exists.
--
-- Generated by `pnpm -C nihongo/backend seed:listening`. Not applied itself:
-- the runner only picks up `.sql`, and this is the template it is built from.
--
-- These cards are normally made by `import-listening.ts`, but production never
-- runs a pipeline script, so this is the same work as a seed.
--
-- WHAT THIS ADDS, precisely: two new exercise types. A listening card shows no
-- word at all -- just audio and four English meanings -- and a dictation card
-- plays the clip and asks for the reading in kana. It adds NO audio. The clips
-- already exist and are already reachable from ordinary vocabulary cards, which
-- is why "Hear it" works today on levels that have no listening card.
--
-- The {{COUNT}} ent_seqs below are literal because eligibility cannot be derived
-- in SQL, and getting this wrong is not cosmetic: a listening card with no clip
-- is unanswerable. An earlier version of this seed tried to derive it by looking
-- for a prompt already pointing at `/audio/words/<ent_seq>.m4a` and treating that
-- as proof the clip was there. It is not proof. `import-vocab-study.ts` writes
-- that path onto every vocabulary card unconditionally, BEFORE any audio is
-- generated -- it prints "Next: run audio:words" immediately afterwards. The
-- reference is a template string. Only the bucket knows, so the generator reads
-- the bucket and writes the answer here.
--
-- Idempotent by unique index -- `study_item_facets(study_item_id, facet)` and
-- `exercise_prompts(facet_id, template_id, version)` -- so a second run inserts
-- nothing. Adds content rows only: no accounts, no srs_cards, no review logs.

-- ---------------------------------------------------------------------------
-- 1. The listening facet.
--
-- `intro_order` 6 puts it last: recognising a word by ear is harder than by
-- sight, so it should not be the first time you meet it.
INSERT INTO study_item_facets (id, study_item_id, facet, enabled, intro_order)
SELECT gen_random_uuid()::text, si.id, 'listening', true, 6
FROM study_items si
JOIN words w ON w.id = si.word_id
WHERE si.published
  AND w.published
  AND w.ent_seq IN (
-- {{ENT_SEQS}}
  )
ON CONFLICT (study_item_id, facet) DO NOTHING;

-- ---------------------------------------------------------------------------
-- 2. The two prompts on that facet.
--
-- Distractors come from the pool of every other word's first gloss, picked by
-- hashing the ent_seq so a word always offers the same wrong answers. Chosen by
-- index into a numbered pool rather than by sorting the pool per word: sorting
-- would be eight thousand comparisons for each of eight thousand words. Five
-- candidates are generated and three kept, which absorbs both a collision
-- between candidates and a candidate that happens to be the right answer.
WITH gloss AS (
  SELECT s.word_id,
         COALESCE(
           (SELECT g ->> 'text' FROM jsonb_array_elements(s.glosses) g
             WHERE g ->> 'lang' = 'en' LIMIT 1),
           (SELECT g ->> 'text' FROM jsonb_array_elements(s.glosses) g LIMIT 1)
         ) AS text
  FROM word_senses s
  WHERE s.sort_index = 0
),
pool AS (
  SELECT text, row_number() OVER (ORDER BY text) AS rn, count(*) OVER () AS total
  FROM (SELECT DISTINCT text FROM gloss WHERE text IS NOT NULL AND text <> '') d
),
target AS (
  SELECT f.id AS facet_id,
         si.language_id,
         w.ent_seq,
         w.primary_form,
         w.primary_reading,
         g.text AS answer,
         -- A stable non-negative seed from the ent_seq.
         (('x' || md5(w.ent_seq::text))::bit(32)::bigint & 2147483647) AS seed
  FROM study_item_facets f
  JOIN study_items si ON si.id = f.study_item_id
  JOIN words w ON w.id = si.word_id
  JOIN gloss g ON g.word_id = w.id
  WHERE f.facet = 'listening'
    AND g.text IS NOT NULL
    AND g.text <> ''
),
picks AS (
  SELECT t.facet_id, p.text
  FROM target t
  CROSS JOIN LATERAL generate_series(0, 4) k
  JOIN pool p
    ON p.rn = 1 + ((t.seed + k * 7919) % p.total)
  WHERE p.text <> t.answer
),
distractors AS (
  SELECT facet_id, jsonb_agg(text) AS list
  FROM (
    SELECT facet_id, text,
           row_number() OVER (PARTITION BY facet_id ORDER BY text) AS n
    FROM (SELECT DISTINCT facet_id, text FROM picks) d
  ) ranked
  WHERE n <= 3
  GROUP BY facet_id
)
INSERT INTO exercise_prompts
  (id, facet_id, template_id, language_id, prompt, answer, distractors, assets)
SELECT
  gen_random_uuid()::text,
  t.facet_id,
  tpl.id,
  t.language_id,
  CASE tpl.code
    -- The word is deliberately NOT in the listening prompt: showing it would
    -- make this a reading exercise with a soundtrack.
    WHEN 'listening' THEN
      jsonb_build_object('kind', 'listening',
                         'instruction', 'Listen. What does it mean?')
    ELSE
      jsonb_build_object('kind', 'dictation',
                         'instruction', 'Listen and type what you hear, in kana',
                         'hint', t.answer)
  END,
  CASE tpl.code
    WHEN 'listening' THEN
      jsonb_build_object('primary', t.answer,
                         'accepted', jsonb_build_array(t.answer))
    ELSE
      jsonb_build_object('primary', t.primary_reading,
                         'accepted', jsonb_build_array(t.primary_reading, t.primary_form))
  END,
  -- Only the multiple-choice card needs wrong answers; dictation is typed.
  CASE tpl.code
    WHEN 'listening' THEN COALESCE(d.list, '[]'::jsonb)
    ELSE '[]'::jsonb
  END,
  jsonb_build_object('audio', '/audio/words/' || t.ent_seq || '.m4a')
FROM target t
CROSS JOIN exercise_templates tpl
LEFT JOIN distractors d ON d.facet_id = t.facet_id
WHERE tpl.code IN ('listening', 'dictation')
ON CONFLICT (facet_id, template_id, version) DO NOTHING;
