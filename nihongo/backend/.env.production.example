# =============================================================================
# PRODUCTION env template — the single source of truth for deployment.
#
# Workflow (see DEPLOY.md Step 5):
#   1. cp .env.production.example .env.production
#   2. fill in real values (see DEPLOY.md → "What nihongo reuses from dmb")
#   3. dotenvx encrypt -f .env.production      # encrypts values in place
#   4. commit the ENCRYPTED .env.production (safe) — NEVER commit .env.keys
#
# At deploy time everything runs under:
#   dotenvx run -f nihongo/backend/.env.production -- docker compose ...
# which decrypts these into the environment so:
#   - docker compose substitutes VITE_* / PG_* (frontend build, backend)
#   - the backend container self-decrypts this same file at startup
#   - the backup script reads PG_* and the S3_* / AWS_* creds
#
# NOTE: nihongo runs no Caddy of its own (dmb's is the shared edge), so there is no
# DOMAIN / ACME_EMAIL here. Only variables the app/scripts actually read are
# listed — no dead vars.
# =============================================================================

# --- App ---
NODE_ENV=production
PORT=3008
LOG_LEVEL=info

# --- Postgres — REUSES dmb's container (shared host), own database `nihongo` ---
# Host is dmb's postgres CONTAINER name, reachable over the shared `futari`
# network. Use dmb's existing credentials; only the database name differs.
# Create it once:  docker exec dmb-postgres createdb -U <PG_USERNAME> nihongo
PG_HOST=dmb-postgres
PG_PORT=5432
PG_USERNAME=replace-with-dmb-pg-username
PG_PASSWORD=replace-with-dmb-pg-password
PG_DATABASE=nihongo
DB_POOL_MAX=10

# --- Auth (secret must be 32+ chars; URL/origins are the PUBLIC https site) ---
# BETTER_AUTH_SECRET is nihongo's OWN — generate fresh, do NOT reuse dmb's:
#   openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
BETTER_AUTH_URL=https://nihongo.futari.live
ALLOWED_ORIGINS=https://nihongo.futari.live

# Public frontend origin (used to build subscription email links back to the SPA)
FRONTEND_URL=https://nihongo.futari.live

# --- Redis — REUSES dmb's container (shared). Keys are namespaced `nihongo-rl` ---
REDIS_HOST=dmb-redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Email (Brevo transactional API — used when NODE_ENV=production) ---
# Reuse dmb's Brevo key. Verify hello@nihongo.futari.live as a sender in Brevo.
BREVO_API_KEY=replace-with-dmb-brevo-key
EMAIL_FROM=hello@nihongo.futari.live
EMAIL_FROM_NAME=go
ADMIN_NOTIFICATION_EMAILS=chiwuzohdumebi@gmail.com

# --- ImageKit (reuse dmb's ImageKit account, or use a separate one) ---
IMAGEKIT_PUBLIC_KEY=replace-with-imagekit-public-key
IMAGEKIT_PRIVATE_KEY=replace-with-imagekit-private-key
IMAGEKIT_URL_ENDPOINT=replace-with-imagekit-url-endpoint

# --- Frontend build vars (read by docker compose build args) ---
# VITE_API_URL must be an ABSOLUTE url (the frontend validates it with z.url()).
# Use the public site origin + /api — same-origin, proxied by nginx.
VITE_API_URL=https://nihongo.futari.live/api
VITE_APP_TITLE=Nihongo

# --- Database backups -> S3-compatible storage (reuse dmb's Cloudflare R2) ---
# nihongo dumps land under the nihongo/ key prefix in the shared bucket.
S3_BUCKET=dmb-backups
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=replace-with-r2-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key

# --- Web Push -----------------------------------------------------------
# Generate once with: npx web-push generate-vapid-keys
# Without these the push arm of the reminder job is skipped silently; email
# still goes out.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Scheduled jobs -----------------------------------------------------
# Shared secret for the reminder endpoint, which host cron calls. Generate
# with: openssl rand -hex 32
# There is no in-app scheduler; see DEPLOY.md step 8.
CRON_SECRET=

# --- Signup -------------------------------------------------------------
# `invite` requires an invite row, `open` lets anyone register, `closed` allows
# no self-signup at all.
#
# Defaults to `invite` to match development. Note that signing in with an
# emailed code CREATES the account if it does not exist — the code flow is a
# sign-up as much as a sign-in — so `open` here really does mean anyone with
# an email address. The invite check runs in a user.create hook that every
# path funnels through, so `invite` cannot be bypassed by using the login page
# instead of the sign-up page.
SIGNUP_MODE=invite
SIGNUP_ALLOWED_DOMAINS=

# --- Proxy --------------------------------------------------------------
# Caddy and nginx sit in front, so the backend must be told whose
# X-Forwarded-For to believe. Docker bridge ranges.
TRUSTED_PROXY_CIDRS=172.16.0.0/12,10.0.0.0/8

# --- Assets on R2 -------------------------------------------------------
# Generated audio (~11,100 clips) and the SVG illustrations live in a public
# Cloudflare R2 bucket, NOT in the frontend image — `.dockerignore` excludes
# `nihongo/frontend/public/audio`.
#
# R2_PUBLIC_BASE_URL is the ONLY one of these the running app reads, and it is
# load-bearing: unset, the API hands out /audio/... paths nginx cannot satisfy
# and every clip 404s, quietly — cards still work, the play button just does
# nothing. The other three are for `upload:assets`, which runs on your Mac.
#
# NOTE the r2.dev hostname is rate-limited and Cloudflare does not recommend it
# for production. It is fine for a closed invite-only app — the service worker
# caches each clip per device for 90 days — but the fix is a custom domain on
# the bucket, which needs futari.live moved to Cloudflare DNS. Because this is
# an env var rather than a stored URL, that migration is a redeploy, not a data
# change. See DEPLOY.md step 7a.
R2_PUBLIC_BASE_URL=https://pub-0ab1d0459b244cdcac19781eb4e6f283.r2.dev
R2_ENDPOINT=https://1b7325655815c2c71f0c9920cf18ae26.r2.cloudflarestorage.com
R2_BUCKET=nihongo-assets
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
