{
  "name": "backend",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --cache --fix",
    "test": "NODE_ENV=test vitest run",
    "drizzle": "NODE_OPTIONS='--import tsx' dotenvx run -- drizzle-kit",
    "drizzle:generate": "NODE_OPTIONS='--import tsx' dotenvx run -- drizzle-kit generate",
    "drizzle:studio": "NODE_OPTIONS='--import tsx' drizzle-kit studio",
    "db:migrate": "DB_MIGRATING=true tsx src/db/migrate.ts",
    "db:seed": "DB_SEEDING=true tsx src/db/seed.ts",
    "import:kanji": "tsx src/pipeline/import-kanji.ts",
    "import:kanji-levels": "tsx src/pipeline/import-kanji-levels.ts",
    "import:kanji-study": "tsx src/pipeline/import-kanji-study.ts",
    "import:pitch": "tsx src/pipeline/import-pitch.ts",
    "import:strokes": "tsx src/pipeline/import-strokes.ts",
    "import:writing": "tsx src/pipeline/import-writing-facets.ts",
    "import:sentences": "tsx src/pipeline/import-sentences.ts",
    "import:cloze": "tsx src/pipeline/import-cloze.ts",
    "import:listening": "tsx src/pipeline/import-listening.ts",
    "import:word-order": "tsx src/pipeline/import-word-order.ts",
    "import:series-drill": "tsx src/pipeline/import-series-drill.ts",
    "import:conjugation": "tsx src/pipeline/import-conjugation.ts",
    "import:phonetics": "tsx src/pipeline/import-phonetics.ts",
    "audio:kana": "tsx src/pipeline/generate-audio.ts kana",
    "audio:words": "tsx src/pipeline/generate-audio.ts words",
    "audio:sentences": "tsx src/pipeline/generate-audio.ts sentences",
    "audio:dialogues": "tsx src/pipeline/generate-audio.ts dialogues",
    "audio:all": "tsx src/pipeline/generate-audio.ts all",
    "admin:create": "tsx src/db/create-admin.ts",
    "typecheck": "tsc --noEmit",
    "import:vocab": "tsx src/pipeline/import-vocab.ts",
    "import:vocab-study": "tsx src/pipeline/import-vocab-study.ts",
    "enrich": "tsx src/pipeline/enrich.ts",
    "import:images": "tsx src/pipeline/import-images.ts",
    "find:rendaku": "tsx src/pipeline/find-rendaku.ts",
    "build:curriculum": "tsx src/pipeline/build-curriculum.ts",
    "upload:assets": "tsx src/pipeline/upload-assets.ts",
    "import:dialogues": "tsx src/pipeline/import-dialogues.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@aws-sdk/client-s3": "^3.1119.0",
    "@dotenvx/dotenvx": "^1.48.2",
    "@hono/node-server": "^1.19.10",
    "@hono/zod-openapi": "^1.1.0",
    "@nihongo/shared": "workspace:*",
    "@scalar/hono-api-reference": "^0.9.11",
    "better-auth": "^1.4.9",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "geolite2-redist": "^3.1.3",
    "hono": "^4.12.18",
    "imagekit": "^5.0.0",
    "ioredis": "^5.6.1",
    "luxon": "^3.7.2",
    "maxmind": "^5.0.7",
    "pg": "^8.16.3",
    "rate-limiter-flexible": "^10.0.1",
    "saxes": "^6.0.0",
    "tsx": "^4.7.1",
    "web-push": "^3.6.7",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.4",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.31.0",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
