NODE_ENV=development
PORT=3008
APP_NAME=go
LOG_LEVEL=info

# Postgres (DATABASE_URL is built from these parts).
# Dev ports are offset so nihongo's local stack can run alongside dmb's and
# abm's without clashing. docker-compose.yml reads PG_PORT/REDIS_PORT from here.
PG_HOST=localhost
PG_PORT=5434
PG_USERNAME=postgres
PG_PASSWORD=postgres
PG_DATABASE=nihongo
DB_POOL_MAX=10

# Auth. Same-origin model: the browser hits the frontend origin and /api is
# proxied to the backend, so BETTER_AUTH_URL is the PUBLIC SITE origin (the
# Vite dev server in dev), not the backend's own port.
BETTER_AUTH_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
BETTER_AUTH_URL=http://localhost:5175

# How self-signup is gated: closed | invite | open.
# `invite` means new accounts need a code you mint from the admin dashboard.
SIGNUP_MODE=invite
# Optional extra gate: comma-separated email domains allowed to register.
SIGNUP_ALLOWED_DOMAINS=

# Trusted origins for auth (comma-separated).
ALLOWED_ORIGINS=http://localhost:5175

# Redis
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=

# Mail — with EMAIL_HOST=smtp.ethereal.email and blank credentials, a throwaway
# Ethereal inbox is created per boot and preview URLs are logged.
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_LOGGER=false
EMAIL_FROM=hello@nihongo.futari.live
EMAIL_FROM_NAME=go

# Brevo transactional email (production only; dev uses SMTP/Ethereal)
BREVO_API_KEY=

# Public frontend origin (used to build email links back to the SPA)
FRONTEND_URL=http://localhost:5175

# Admin notification recipients (comma-separated)
ADMIN_NOTIFICATION_EMAILS=

# ImageKit — flashcard and grammar illustrations. Blank disables uploads.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Cloudflare R2 — pre-generated TTS audio and stroke assets. Public bucket,
# zero egress. The app only reads; the import pipeline writes.
R2_PUBLIC_BASE_URL=
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Anthropic — content enrichment ONLY. Never called on a request path; the
# pipeline runs offline via the Batch API and everything it produces goes
# through human review before publication.
ANTHROPIC_API_KEY=

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@nihongo.futari.live

# Shared secret for the host-cron reminder trigger (this stack has no in-app
# scheduler — cron POSTs to /notifications/run-reminders with this).
CRON_SECRET=

# GeoLite2 directory (shared with the dmb stack in production)
GEOLITE_DB_DIR=./geodata

# Comma-separated CIDRs whose X-Forwarded-For is trusted (the nginx/Caddy hop)
TRUSTED_PROXY_CIDRS=

# Google sign-in. Optional — leave both blank and the button never appears.
#
# Create the OAuth client under your OWN Google account at
# console.cloud.google.com (APIs & Services -> Credentials -> OAuth client ID ->
# Web application). The redirect URI is BETTER_AUTH_URL + /api/auth/callback/google,
# which in dev is http://localhost:5175/api/auth/callback/google — note that
# BETTER_AUTH_URL is the SITE origin, not the backend port, because /api is
# proxied. Add the same origin under Authorized JavaScript origins.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
