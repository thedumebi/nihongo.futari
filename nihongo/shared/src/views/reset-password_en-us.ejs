<%- include("partials/header") -%>

<h1 style="margin: 0 0 16px; color: #2f4858; font-size: 22px;">Reset your password</h1>
<p style="margin: 0 0 24px;">
  Hi <%= name %>, click the button below to set a new password. The link expires in 1 hour.
</p>
<a href="<%= url %>" style="display: inline-block; background: #2f4858; color: #ffffff; text-decoration: none; padding: 12px 24px; border-radius: 8px; font-weight: 600;">
  Reset password
</a>
<p style="margin: 24px 0 0; color: #888888; font-size: 13px;">
  If you didn't request a password reset, you can safely ignore this email.
</p>

<%- include("partials/footer") -%>
