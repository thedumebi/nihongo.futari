                </td>
              </tr>
              <!-- footer -->
              <tr>
                <td style="background: #f2f5f7; padding: 24px 32px; font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 1.6; color: #888888;">
                  <p style="margin: 0;">&copy; <%= currentYear %> <%= siteName %>.</p>
                  <% if (locals.unsubscribeUrl) { %>
                    <p style="margin: 8px 0 0;">
                      <a href="<%= unsubscribeUrl %>" style="color: #888888; text-decoration: underline;">Unsubscribe</a>.
                    </p>
                  <% } %>
                </td>
              </tr>
            </table>
          </td>
        </tr>
      </table>
    </center>
  </body>
</html>
