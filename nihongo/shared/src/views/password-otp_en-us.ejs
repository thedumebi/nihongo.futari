<%- include("partials/header") -%>

<h1 style="margin: 0 0 16px; color: #2f4858; font-size: 22px;">Set your password</h1>
<p style="margin: 0 0 16px;">
  Hi <%= name %>, use the code below to finish setting your <%= siteName %> password.
</p>
<div style="letter-spacing: 6px; font-size: 30px; font-weight: 700; color: #2f4858; margin: 8px 0 16px;">
  <%= otp %>
</div>
<p style="margin: 0; color: #888888; font-size: 13px;">
  This code expires in 10 minutes. If you didn't ask to set a password, you can ignore the email — your account is unchanged.
</p>

<%- include("partials/footer") -%>
