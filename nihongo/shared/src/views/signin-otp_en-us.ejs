<%- include("partials/header") -%>

<h1 style="margin: 0 0 16px; color: #2f4858; font-size: 22px;">Your sign-in code</h1>
<p style="margin: 0 0 16px;">
  Use the code below to finish signing in to <%= siteName %>.
</p>
<div style="letter-spacing: 6px; font-size: 30px; font-weight: 700; color: #2f4858; margin: 8px 0 16px;">
  <%= otp %>
</div>
<p style="margin: 0 0 8px; color: #888888; font-size: 13px;">
  This code expires in 10 minutes.
</p>
<p style="margin: 0; color: #888888; font-size: 13px;">
  Didn't request this? You can safely ignore this email — no one will be able to sign in without the code above.
</p>

<%- include("partials/footer") -%>
