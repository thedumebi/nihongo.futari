<%- include("partials/header") -%>

<h1 style="margin: 0 0 16px; color: #2f4858; font-size: 22px;">You're invited</h1>
<p style="margin: 0 0 24px;">
  Hi <%= name %>, <%= invitedBy %> has invited you to learn Japanese on 語.
  Accounts here are invite-only, so this link is yours.
</p>
<a href="<%= url %>" style="display: inline-block; background: #2f4858; color: #ffffff; text-decoration: none; padding: 12px 24px; border-radius: 8px; font-weight: 600;">
  Create your account
</a>
<p style="margin: 24px 0 0;">
  If the button doesn't work, go to the sign-up page and enter this code:
</p>
<p style="margin: 8px 0 0; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 20px; letter-spacing: 2px; color: #2f4858;">
  <%= code %>
</p>
<p style="margin: 24px 0 0; color: #888888; font-size: 13px;">
  The invitation expires on <%= expiresAt %>. If you weren't expecting this, you
  can ignore it &mdash; nothing happens until you use the code.
</p>

<%- include("partials/footer") -%>
