<%- include("partials/header") -%>

<h1 style="margin: 0 0 16px; color: #2f4858; font-size: 22px;">Confirm your email</h1>
<p style="margin: 0 0 24px;">
  Hi <%= name %>, confirm this address to finish setting up your account.
</p>
<a href="<%= url %>" style="display: inline-block; background: #2f4858; color: #ffffff; text-decoration: none; padding: 12px 24px; border-radius: 8px; font-weight: 600;">
  Confirm email
</a>
<p style="margin: 24px 0 0; color: #888888; font-size: 13px;">
  If you didn't create an account, you can safely ignore this email.
</p>

<%- include("partials/footer") -%>
