{
  "name": "nihongo.futari",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,vue,md}\"",
    "create:db": "pnpm --filter @nihongo/shared create:db",
    "drop:db": "pnpm --filter @nihongo/shared drop:db",
    "drizzle:generate": "turbo run drizzle:generate",
    "db:seed": "turbo run db:seed",
    "db:migrate": "turbo run db:migrate",
    "test": "turbo test",
    "typecheck": "turbo run typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.1",
    "turbo": "^2.5.5",
    "typescript": "5.8.3"
  },
  "lint-staged": {
    "nihongo/backend/**/*.{js,ts,tsx}": [
      "cd nihongo/backend && npm run lint:fix"
    ],
    "nihongo/frontend/**/*.{js,ts,tsx,vue}": [
      "cd nihongo/frontend && npm run lint:fix"
    ],
    "nihongo/shared/**/*.{js,ts,tsx}": [
      "cd nihongo/shared && npm run lint:fix"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "better-sqlite3",
      "vue-demi",
      "fsevents",
      "@tailwindcss/oxide",
      "core-js"
    ]
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": "22.17.0",
    "npm": "Please use pnpm instead of npm to install dependencies",
    "yarn": "Please use pnpm instead of yarn to install dependencies",
    "pnpm": "9.0.0"
  }
}
