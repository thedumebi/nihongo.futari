# Generated pronunciation audio. ~8 MB for N5 alone and it grows with every
# level, so it stays out of git history. Regenerate with:
#   pnpm -C nihongo/backend audio:kana && pnpm -C nihongo/backend audio:words
# Production serves it from R2.
nihongo/frontend/public/audio/

# Vite's local dep-optimisation cache. Regenerated on every dev start.
.vite/
