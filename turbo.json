{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".nvmrc", "packages/typescript-config/*.json"],
  "ui": "tui",
  "remoteCache": {
    "enabled": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "package.json", "tsconfig*.json", "!**/*.test.ts", "!**/*.spec.ts", "!**/tests/**"],
      "outputs": ["dist/**"],
      "cache": true
    },
    "start": {
      "dependsOn": ["^start"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "drizzle:generate": {
      "cache": false,
      "dependsOn": ["^drizzle:generate", "@nihongo/shared#build"]
    },
    "db:seed": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
